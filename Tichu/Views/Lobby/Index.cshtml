@model Tichu.Models.ViewModels.LobbyViewModel
@{
    ViewData["Title"] = "티츄 로비";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">🃏 Tichu 로비</h3>
        <div class="d-flex align-items-center gap-2">
            <a href="/Home/MyPage" class="badge bg-info text-dark text-decoration-none" title="마이페이지">나: @Model.Nickname</a>
            <a href="/Lobby/Create" class="btn btn-primary">방 만들기</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div id="emptyMsg" class="text-muted text-center py-5" style="display:none;">아직 생성된 방이 없습니다. 첫 방을 만들어보세요!</div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>방 이름</th>
                    <th>목표 점수</th>
                    <th>턴 시간</th>
                    <th>인원</th>
                    <th>상태</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="roomList"></tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const statusLabel = { Waiting: '대기중', Playing: '게임중', Ended: '종료' };
    const statusBadge = { Waiting: 'bg-success text-white', Playing: 'bg-warning text-dark', Ended: 'bg-secondary text-white' };

    function renderRooms(rooms) {
        const tbody = document.getElementById('roomList');
        const emptyMsg = document.getElementById('emptyMsg');
        tbody.innerHTML = '';

        if (!rooms || rooms.length === 0) {
            emptyMsg.style.display = '';
            return;
        }
        emptyMsg.style.display = 'none';

        rooms.forEach(r => {
            const tr = document.createElement('tr');
            const canJoin = r.status === 'Waiting' && r.playerCount < 4;
            tr.innerHTML = `
                <td>${escapeHtml(r.name)}</td>
                <td>${r.targetScore}점</td>
                <td>${r.turnTimeLimit}초</td>
                <td>${r.playerCount} / 4</td>
                <td><span class="badge ${statusBadge[r.status] || 'bg-secondary text-white'}">${statusLabel[r.status] || r.status}</span></td>
                <td class="text-end">
                    ${canJoin
                        ? `<a href="/Lobby/Room/${r.id}" class="btn btn-sm btn-primary">입장</a>`
                        : `<button class="btn btn-sm btn-outline-secondary" disabled>입장 불가</button>`}
                </td>`;
            tbody.appendChild(tr);
        });
    }

    function escapeHtml(s) {
        const div = document.createElement('div');
        div.textContent = s ?? '';
        return div.innerHTML;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/tichuHub")
        .withAutomaticReconnect()
        .build();

    connection.on("RoomListUpdated", renderRooms);

    async function start() {
        try {
            await connection.start();
            await connection.invoke("JoinLobby");
        } catch (e) {
            console.error(e);
            setTimeout(start, 2000);
        }
    }

    connection.onreconnected(() => connection.invoke("JoinLobby").catch(console.error));

    start();
</script>
