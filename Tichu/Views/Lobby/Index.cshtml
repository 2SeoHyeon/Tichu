@model Tichu.Models.ViewModels.LobbyViewModel
@{
    ViewData["Title"] = "게임 로비";
    Layout = "_Layout";
}

<main class="lobby-shell">
    <header class="lobby-topbar">
        <a class="brand-lockup lobby-brand" href="/Lobby" aria-label="티츄 로비 홈"><span class="brand-mark" aria-hidden="true">♣</span><span>TICHU<span class="brand-period">.</span></span></a>
        <div class="lobby-account">
            <span class="online-indicator"></span>
            <span class="account-name">@Model.Nickname</span>
            <a href="/Home/MyPage" class="account-avatar" title="마이페이지" aria-label="마이페이지">@Model.Nickname.Substring(0, 1)</a>
        </div>
    </header>

    <section class="lobby-heading">
        <div>
            <span class="eyebrow lobby-eyebrow"><span class="eyebrow-dot"></span> TICHU CLUB</span>
            <h1>게임 로비</h1>
            <p>열려 있는 방에 참여하거나, 친구들을 위한 새 게임을 만들어보세요.</p>
        </div>
        <a href="/Lobby/Create" class="btn-create-room"><span aria-hidden="true">＋</span> 방 만들기</a>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <section class="rooms-panel">
        <div class="rooms-panel-head">
            <div><h2>열려 있는 방</h2><p>지금 바로 시작할 수 있는 게임을 찾아보세요.</p></div>
            <div class="live-label"><span class="online-indicator"></span> 실시간 업데이트</div>
        </div>
        <div id="emptyMsg" class="empty-rooms" style="display:none;">
            <div class="empty-icon" aria-hidden="true">♧</div>
            <h3>아직 열린 방이 없어요</h3>
            <p>첫 번째 방을 만들고 친구들을 초대해보세요.</p>
            <a href="/Lobby/Create" class="btn-empty-create">새 방 만들기 <span aria-hidden="true">↗</span></a>
        </div>
        <div id="roomList" class="room-list" aria-live="polite"></div>
    </section>
    <footer class="lobby-footer"><span>좋은 게임은 좋은 사람들과 함께</span><span>♣ &nbsp; TICHU</span></footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const statusLabel = { Waiting: '대기 중', Playing: '게임 중', Ended: '종료' };
    const statusClass = { Waiting: 'room-status-waiting', Playing: 'room-status-playing', Ended: 'room-status-ended' };

    function renderRooms(rooms) {
        const list = document.getElementById('roomList');
        const emptyMsg = document.getElementById('emptyMsg');
        list.innerHTML = '';

        if (!rooms || rooms.length === 0) {
            emptyMsg.style.display = '';
            return;
        }
        emptyMsg.style.display = 'none';

        rooms.forEach(r => {
            const canJoin = r.status === 'Waiting' && r.playerCount < 4;
            const card = document.createElement('article');
            card.className = 'room-card';
            card.innerHTML = `
                <div class="room-card-main">
                    <div class="room-icon" aria-hidden="true">♣</div>
                    <div class="room-title-wrap">
                        <h3>${escapeHtml(r.name)}</h3>
                        <span class="room-host">티츄 테이블</span>
                    </div>
                    <span class="room-status ${statusClass[r.status] || 'room-status-ended'}"><span></span>${escapeHtml(statusLabel[r.status] || r.status)}</span>
                </div>
                <div class="room-card-meta">
                    <div class="room-meta-item"><span>목표 점수</span><strong>${escapeHtml(r.targetScore)}<small>점</small></strong></div>
                    <div class="room-meta-item"><span>턴 제한</span><strong>${escapeHtml(r.turnTimeLimit)}<small>초</small></strong></div>
                    <div class="room-meta-item"><span>참가 인원</span><strong>${escapeHtml(r.playerCount)}<small> / 4명</small></strong><div class="seat-track"><i style="width:${Math.min((Number(r.playerCount) || 0) * 25, 100)}%"></i></div></div>
                </div>
                <div class="room-card-action">
                    ${canJoin
                        ? `<a href="/Lobby/Room/${encodeURIComponent(r.id)}" class="btn-join-room">입장하기 <span aria-hidden="true">→</span></a>`
                        : `<button class="btn-join-room is-disabled" disabled>입장 불가</button>`}
                </div>`;
            list.appendChild(card);
        });
    }

    function escapeHtml(value) {
        const div = document.createElement('div');
        div.textContent = value ?? '';
        return div.innerHTML;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/tichuHub")
        .withAutomaticReconnect()
        .build();

    connection.on("RoomListUpdated", renderRooms);

    async function start() {
        try {
            await connection.start();
            await connection.invoke("JoinLobby");
        } catch (e) {
            console.error(e);
            setTimeout(start, 2000);
        }
    }

    connection.onreconnected(() => connection.invoke("JoinLobby").catch(console.error));
    start();
</script>