@model Tichu.Models.GameRoom
@{
    ViewData["Title"] = "방 생성";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 480px;">
    <h3>방 생성</h3>
    <form method="post" asp-action="Create" asp-controller="Lobby">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">방 이름</label>
            <input name="name" class="form-control" maxlength="30" placeholder="티추 한판~!" />
        </div>

        <div class="mb-3">
            <label class="form-label">목표 점수</label>
            <select name="targetScore" class="form-select">
                <option value="500">500점</option>
                <option value="1000" selected>1000점</option>
                <option value="2000">2000점</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">턴 시간 (초)</label>
            <input name="turnTimeLimit" type="number" class="form-control" min="10" max="120" value="30" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">생성</button>
            <a href="/Lobby" class="btn btn-outline-secondary">취소</a>
        </div>
    </form>
</div>
