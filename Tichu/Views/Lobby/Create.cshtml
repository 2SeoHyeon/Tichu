@model Tichu.Models.ViewModels.GamePlayViewModel
@{
    ViewData["Title"] = $"Room #{Model.RoomId} - {Model.RoomName}";
    Layout = "_Layout";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
        <h5 class="m-0">🃏 Tichu – @Model.RoomName (#@Model.RoomId)</h5>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge text-bg-secondary">턴 제한: <strong id="turnLimit">@Model.TurnTimeLimit</strong>초</span>
            <span class="badge text-bg-info">나: @Model.Nickname</span>
            @if (Model.IsHost)
            {
                <span class="badge text-bg-warning">Host</span>
            }
            <a href="/Lobby" class="btn btn-sm btn-outline-secondary">로비로</a>
        </div>
    </div>

    <!-- 상단: 플레이어 보드 -->
    <div class="row g-2">
        <div class="col-12 col-md-3">
            <div class="card h-100">
                <div class="card-header py-2">플레이어</div>
                <div class="card-body p-2">
                    <ul id="players" class="list-group list-group-flush small">
                        <!-- 실시간 갱신 -->
                    </ul>
                </div>
            </div>
        </div>

        <!-- 중앙: 테이블/현재 트릭 -->
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <span>테이블</span>
                    <div class="progress w-50" role="progressbar">
                        <div id="turnProgress" class="progress-bar" style="width: 100%"></div>
                    </div>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height:240px;">
                    <div id="lastPlay" class="text-center mb-2">
                        <div class="text-muted small">이전 패</div>
                        <div id="lastPlayCards" class="d-flex flex-wrap justify-content-center gap-2"></div>
                    </div>
                    <div id="currentPlay" class="text-center">
                        <div class="text-muted small">내가 낼 패</div>
                        <div id="currentPlayCards" class="d-flex flex-wrap justify-content-center gap-2"></div>
                        <div class="mt-2 d-flex gap-2 justify-content-center">
                            <button id="btnPlay" class="btn btn-sm btn-success">내기</button>
                            <button id="btnPass" class="btn btn-sm btn-outline-secondary">패스</button>
                            <button id="btnClear" class="btn btn-sm btn-outline-danger">선택 해제</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 우측: 로그/채팅 -->
        <div class="col-12 col-md-3">
            <div class="card h-100">
                <div class="card-header py-2">로그</div>
                <div class="card-body p-2">
                    <div id="log" class="small" style="height:240px; overflow:auto;"></div>
                    <hr class="my-2" />
                    <div class="input-group input-group-sm">
                        <input id="chatInput" type="text" class="form-control" placeholder="메시지" />
                        <button id="btnSendChat" class="btn btn-outline-primary">보내기</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 하단: 내 손패 -->
    <div class="card mt-3">
        <div class="card-header py-2">내 패</div>
        <div id="myHand" class="card-body d-flex flex-row flex-nowrap gap-2 overflow-auto">
            <!-- 실시간 렌더링 (가짜 데이터 시작점) -->
        </div>
    </div>
</div>

<!-- SignalR client -->
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.14/dist/browser/signalr.min.js"></script>

<script>
    // ====== 초기 데이터 ======
    const ROOM_ID = @Model.RoomId;
    const NICK = "@Model.Nickname".trim();
    const TURN_LIMIT = @Model.TurnTimeLimit;

    // 손패 더미(초기 렌더 샘플) — 실제론 서버에서 배분 후 hub로 수신
    // 서버 연결 전 미리 UI 테스트 가능
    let myHand = [
        { suit:"♠", rank:"A", key:"♠A" },
        { suit:"♠", rank:"K", key:"♠K" },
        { suit:"♥", rank:"10", key:"♥10"},
        { suit:"♦", rank:"7", key:"♦7" },
        { suit:"♣", rank:"3", key:"♣3" },
        { suit:"Special", rank:"Dragon", key:"DRG" },
        { suit:"Special", rank:"Phoenix", key:"PHX" }
    ];

    let currentSelect = [];  // 내가 이번에 낼 카드
    let lastPlay = [];       // 테이블에 놓인 이전 패

    // ====== 유틸 ======
    const log = (msg) => {
        const el = document.getElementById('log');
        const row = document.createElement('div');
        row.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
        el.appendChild(row);
        el.scrollTop = el.scrollHeight;
    };

    function cardBadge(card, clickable){
        const div = document.createElement('div');
        div.className = 'border rounded px-2 py-1 bg-light';
        div.textContent = `${card.rank}${card.suit === 'Special' ? '' : card.suit}${card.rank==='Dragon'?' 🐉':card.rank==='Phoenix'?' 🔥':card.rank==='Dog'?' 🐶':card.rank==='Mahjong'?' 🀄':''}`;
        if(clickable){
            div.style.cursor = 'pointer';
            div.onclick = () => toggleSelect(card.key);
        }
        return div;
    }

    function renderHand(){
        const hand = document.getElementById('myHand');
        hand.innerHTML = '';
        myHand.forEach(c => hand.appendChild(cardBadge(c, true)));
    }

    function renderCurrent(){
        const area = document.getElementById('currentPlayCards');
        area.innerHTML = '';
        currentSelect.forEach(c => area.appendChild(cardBadge(c, false)));
    }

    function renderLast(){
        const area = document.getElementById('lastPlayCards');
        area.innerHTML = '';
        lastPlay.forEach(c => area.appendChild(cardBadge(c, false)));
    }

    function toggleSelect(key){
        const idx = currentSelect.findIndex(c => c.key === key);
        if(idx >= 0){
            currentSelect.splice(idx,1);
        } else {
            const card = myHand.find(c => c.key === key);
            if(card) currentSelect.push(card);
        }
        renderCurrent();
    }

    // 턴 타이머 표시 (프로그레스바 줄이기)
    let timerInterval = null;
    function startTurnTimer(seconds){
        const bar = document.getElementById('turnProgress');
        let remain = seconds;
        if(timerInterval) clearInterval(timerInterval);

        bar.style.width = '100%';
        timerInterval = setInterval(() => {
            remain--;
            const ratio = Math.max(0, (remain / seconds) * 100);
            bar.style.width = ratio + '%';
            if(remain <= 0){
                clearInterval(timerInterval);
                log('⏰ 시간 초과, 자동 패스');
                // 서버 통지
                connection.invoke('NotifyTurnEnd', ROOM_ID.toString(), NICK).catch(err => console.error(err));
            }
        }, 1000);
    }

    // ====== SignalR 연결 ======
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/tichuHub")
        .withAutomaticReconnect()
        .build();

    connection.on("PlayerJoined", (nickname) => {
        log(`입장: ${nickname}`);
        addPlayer(nickname);
    });

    connection.on("PlayerLeft", (nickname) => {
        log(`퇴장: ${nickname}`);
        removePlayer(nickname);
    });

    connection.on("ReceivePlay", (player, playJson) => {
        const cards = JSON.parse(playJson);
        lastPlay = cards;
        renderLast();
        log(`▶ ${player} 가 카드를 냈습니다: ${cards.map(c=>c.rank+(c.suit==='Special'?'':c.suit)).join(', ')}`);
        // 다음 턴 타이머 시작(예시)
        startTurnTimer(TURN_LIMIT);
    });

    connection.on("TurnEnded", (player) => {
        log(`⏭ ${player} 턴 종료`);
        startTurnTimer(TURN_LIMIT);
    });

    async function start(){
        try{
            await connection.start();
            await connection.invoke('JoinRoom', ROOM_ID.toString(), NICK);
            log('✅ 서버에 연결됨');
            startTurnTimer(TURN_LIMIT);
            renderHand();
            renderCurrent();
            renderLast();
        }catch(e){
            console.error(e);
            log('❌ 서버 연결 실패');
        }
    }

    // ====== 플레이어 리스트 표시 (간단)
    function addPlayer(nickname){
        const ul = document.getElementById('players');
        if([...ul.children].some(li => li.dataset.nick === nickname)) return;
        const li = document.createElement('li');
        li.className = 'list-group-item d-flex justify-content-between align-items-center';
        li.dataset.nick = nickname;
        li.innerHTML = `<span>${nickname}</span><span class="badge rounded-pill text-bg-secondary">Ready?</span>`;
        ul.appendChild(li);
    }
    function removePlayer(nickname){
        const ul = document.getElementById('players');
        const li = [...ul.children].find(li => li.dataset.nick === nickname);
        if(li) ul.removeChild(li);
    }
    addPlayer(NICK); // 내 닉네임 먼저 표시

    // ====== 버튼 핸들러 ======
    document.getElementById('btnPlay').onclick = async () => {
        if(currentSelect.length === 0){
            log('카드를 선택하세요.');
            return;
        }
        // 서버 전송
        const payload = JSON.stringify(currentSelect);
        await connection.invoke('SendPlay', ROOM_ID.toString(), NICK, payload);
        // 손패에서 제거
        currentSelect.forEach(sel => {
            const idx = myHand.findIndex(c => c.key === sel.key);
            if(idx >= 0) myHand.splice(idx,1);
        });
        currentSelect = [];
        renderHand();
        renderCurrent();
    };

    document.getElementById('btnPass').onclick = async () => {
        log('패스했습니다.');
        await connection.invoke('NotifyTurnEnd', ROOM_ID.toString(), NICK);
        currentSelect = [];
        renderCurrent();
    };

    document.getElementById('btnClear').onclick = () => {
        currentSelect = [];
        renderCurrent();
    };

    // 채팅(샘플: 현재는 로그에만 기록)
    document.getElementById('btnSendChat').onclick = () => {
        const v = document.getElementById('chatInput').value.trim();
        if(!v) return;
        log(`💬 ${NICK}: ${v}`);
        document.getElementById('chatInput').value = "";
    };

    // 시작
    start();
</script>

<style>
    /* 모바일에서 카드 목록 가로 스크롤 쾌적하게 */
    #myHand::-webkit-scrollbar {
        height: 8px;
    }

    #myHand::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 4px;
    }

    /* 카드 뱃지 미니 스타일 */
    #myHand .border, #currentPlayCards .border, #lastPlayCards .border {
        min-width: 56px;
        text-align: center;
    }
</style>
