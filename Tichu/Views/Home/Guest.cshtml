@{
    ViewData["Title"] = "비회원으로 계속하기";
    Layout = "_Layout";
}

<main class="welcome-shell">
    <div class="welcome-glow welcome-glow-one"></div>
    <div class="welcome-glow welcome-glow-two"></div>
    <section class="welcome-card">
        <a class="brand-lockup" href="/" aria-label="티츄 홈" style="text-decoration:none;">
            <span class="brand-mark" aria-hidden="true">♣</span>
            <span>TICHU<span class="brand-period">.</span></span>
        </a>

        <div class="welcome-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> 비회원 입장</span>
            <h1>닉네임만 정하면<br /><span>바로 시작</span></h1>
            <p>계정 없이 닉네임만으로 바로 게임에 들어갈 수 있어요.</p>
        </div>

        <div class="welcome-form-wrap">
            <div class="alert alert-warning py-2 mb-3" role="alert" style="font-size:13px;">
                ⚠ 비회원으로 시작하면 전적·티어 등 로그인 시 제공되는 기능은 사용할 수 없고, 쿠키가 지워지거나 다른 기기로 접속하면 지금 진행 상황을 이어갈 수 없어요.
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">@ViewBag.Error</div>
            }
            <form method="post" asp-action="GuestEnter" asp-controller="Home" class="welcome-form">
                @Html.AntiForgeryToken()
                <label for="nickname">닉네임</label>
                <div class="nickname-field">
                    <span class="nickname-icon" aria-hidden="true">✦</span>
                    <input id="nickname" name="nickname" maxlength="12" placeholder="닉네임을 입력하세요" autocomplete="nickname" autofocus required />
                </div>
                <button type="submit" class="btn-start">
                    <span>비회원으로 시작하기</span><span aria-hidden="true">↗</span>
                </button>
            </form>
            <p class="form-note"><a href="/" style="color:inherit;">다른 방법으로 로그인</a></p>
        </div>

        <footer class="welcome-footer"><span>전략과 우정이 만나는 곳</span><span>EST. TICHU NIGHT</span></footer>
    </section>
</main>
