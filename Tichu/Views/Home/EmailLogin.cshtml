@{
    ViewData["Title"] = "이메일로 로그인";
    Layout = "_Layout";
}

<main class="welcome-shell">
    <div class="welcome-glow welcome-glow-one"></div>
    <div class="welcome-glow welcome-glow-two"></div>
    <section class="welcome-card">
        <a class="brand-lockup" href="/" aria-label="티츄 홈" style="text-decoration:none;">
            <span class="brand-mark" aria-hidden="true">♣</span>
            <span>TICHU<span class="brand-period">.</span></span>
        </a>

        <div class="welcome-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> 이메일 로그인</span>
            <h1>이메일로<br /><span>계속하기</span></h1>
            <p>처음이면 자동으로 계정이 만들어져요.<br />기존 계정이면 비밀번호로 로그인돼요.</p>
        </div>

        <div class="welcome-form-wrap">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">@ViewBag.Error</div>
            }
            <form method="post" asp-action="EmailAuth" asp-controller="Home" class="welcome-form">
                @Html.AntiForgeryToken()
                <label for="email">이메일</label>
                <div class="nickname-field">
                    <span class="nickname-icon" aria-hidden="true">✦</span>
                    <input id="email" name="email" type="email" placeholder="이메일을 입력하세요" autocomplete="email" autofocus required />
                </div>
                <label for="password" style="margin-top:14px;">비밀번호</label>
                <div class="nickname-field">
                    <span class="nickname-icon" aria-hidden="true">✦</span>
                    <input id="password" name="password" type="password" placeholder="비밀번호 (6자 이상)" autocomplete="current-password" minlength="6" required />
                </div>
                <button type="submit" class="btn-start">
                    <span>이메일로 계속하기</span><span aria-hidden="true">↗</span>
                </button>
            </form>
            <p class="form-note"><a href="/" style="color:inherit;">다른 방법으로 로그인</a></p>
        </div>

        <footer class="welcome-footer"><span>전략과 우정이 만나는 곳</span><span>EST. TICHU NIGHT</span></footer>
    </section>
</main>
