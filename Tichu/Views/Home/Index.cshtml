@{
    ViewData["Title"] = "티츄에 오신 것을 환영합니다";
    Layout = "_Layout";
}

<main class="welcome-shell">
    <div class="welcome-glow welcome-glow-one"></div>
    <div class="welcome-glow welcome-glow-two"></div>
    <section class="welcome-card">
        <div class="brand-lockup">
            <span class="brand-mark" aria-hidden="true">♣</span>
            <span>TICHU<span class="brand-period">.</span></span>
        </div>

        <div class="welcome-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> 친구들과 함께하는 카드 게임</span>
            <h1>오늘, 티츄 한 판<br /><span>어때요?</span></h1>
            <p>닉네임만 정하면 바로 시작할 수 있어요.<br />친구들과 방을 만들고 승부를 겨뤄보세요.</p>
        </div>

        <div class="playing-cards" aria-hidden="true">
            <div class="playing-card card-one"><span>♠</span><strong>A</strong></div>
            <div class="playing-card card-two"><span class="suit-red">♥</span><strong class="suit-red">10</strong></div>
            <div class="playing-card card-three"><span>♣</span><strong>J</strong></div>
        </div>

        <div class="welcome-form-wrap">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">@ViewBag.Error</div>
            }
            <form method="post" asp-action="Enter" asp-controller="Home" class="welcome-form">
                @Html.AntiForgeryToken()
                <label for="nickname">플레이어 이름</label>
                <div class="nickname-field">
                    <span class="nickname-icon" aria-hidden="true">✦</span>
                    <input id="nickname" name="nickname" maxlength="12" placeholder="닉네임을 입력하세요" autocomplete="nickname" autofocus required />
                </div>
                <button type="submit" class="btn-start">
                    <span>게임 시작하기</span><span aria-hidden="true">↗</span>
                </button>
            </form>
            <p class="form-note"><span aria-hidden="true">✓</span> 회원가입 없이 무료로 즐길 수 있어요</p>

            @if (ViewBag.SocialLoginEnabled == true)
            {
                <div class="social-login-divider"><span>또는</span></div>
                <div class="social-login-buttons">
                    @if (ViewBag.GoogleEnabled == true)
                    {
                        <a href="/Home/ExternalLogin?provider=Google" class="btn-social btn-social-google">Google로 계속하기</a>
                    }
                    @if (ViewBag.NaverEnabled == true)
                    {
                        <a href="/Home/ExternalLogin?provider=Naver" class="btn-social btn-social-naver">네이버로 계속하기</a>
                    }
                    @if (ViewBag.KakaoEnabled == true)
                    {
                        <a href="/Home/ExternalLogin?provider=Kakao" class="btn-social btn-social-kakao">카카오로 계속하기</a>
                    }
                </div>
            }
        </div>

        <footer class="welcome-footer"><span>전략과 우정이 만나는 곳</span><span>EST. TICHU NIGHT</span></footer>
    </section>
</main>