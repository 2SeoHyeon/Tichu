@{
    ViewData["Title"] = "마이페이지";
    Layout = "_Layout";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="max-width: 420px; width: 100%;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0">마이페이지</h4>
                <a href="/Lobby" class="btn btn-sm btn-outline-secondary">로비로</a>
            </div>

            @if (TempData["Saved"] != null)
            {
                <div class="alert alert-success py-2">닉네임이 변경되었습니다.</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }

            <p class="text-muted mb-3">현재 닉네임: <strong>@ViewBag.Nickname</strong></p>

            <form method="post" asp-action="UpdateNickname" asp-controller="Home">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">새 닉네임</label>
                    <input name="nickname" class="form-control" maxlength="12" value="@ViewBag.Nickname" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">닉네임 변경</button>
            </form>

            <hr class="my-4" />

            <a href="/Home/ChangeNickname" class="btn btn-outline-danger w-100">다른 닉네임으로 새로 시작 (로그아웃)</a>
        </div>
    </div>
</div>
